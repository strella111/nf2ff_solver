QWidget {
    color: #1f2933;
    selection-background-color: ${SELECTION_BG};
    selection-color: #0f172a;
    font-size: ${FONT_SIZE_BASE};
}

QMainWindow,
QDialog {
    background-color: #f4f6f8;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cfd7e3;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: ${ACCENT_SOFT};
    color: ${ACCENT_TEXT};
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8dee7;
    border-radius: 7px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #344054;
    background-color: #ffffff;
}

QLabel {
    background: transparent;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit {
    background-color: #ffffff;
    border: 1px solid #cfd7e3;
    border-radius: 5px;
    padding: 4px 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus {
    border-color: ${ACCENT_FOCUS};
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #eef1f5;
    color: #8a96a3;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #d8dee7;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #f8fafc;
}

QComboBox::drop-down:hover {
    background-color: ${ACCENT_SOFT};
    border-left-color: ${ACCENT_SOFT_BORDER};
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: url("${STYLE_DIR}/icons/chevron-down.svg");
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 12px;
    border-left: 1px solid #d8dee7;
    border-bottom: 1px solid #d8dee7;
    border-top-right-radius: 5px;
    background-color: #f8fafc;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 12px;
    border-left: 1px solid #d8dee7;
    border-bottom-right-radius: 5px;
    background-color: #f8fafc;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: ${ACCENT_SOFT};
    border-left-color: ${ACCENT_SOFT_BORDER};
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: ${ACCENT_SOFT_PRESSED};
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 8px;
    height: 8px;
    image: url("${STYLE_DIR}/icons/chevron-up.svg");
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
    image: url("${STYLE_DIR}/icons/chevron-down.svg");
}

QPushButton,
QToolButton {
    background-color: #ffffff;
    border: 1px solid #c9d2df;
    border-radius: 5px;
    padding: 4px 9px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: ${ACCENT_SOFT};
    border-color: ${ACCENT_SOFT_BORDER};
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: ${ACCENT_SOFT_PRESSED};
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #eef1f5;
    border-color: #d8dee7;
    color: #9aa5b1;
}

/* Фокус с клавиатуры был виден только у полей ввода — у кнопок его не было
   вовсе, и навигация с Tab шла вслепую. */
QPushButton:focus,
QToolButton:focus {
    border-color: ${ACCENT_FOCUS};
}

/* Главное действие экрана. Раньше все кнопки были одинаково белыми, и взгляду
   не за что было зацепиться: «Открыть папку» весила столько же, сколько
   «Инверт.». Ставится через свойство primary (см. FarFieldDialog._set_primary),
   ровно одна кнопка на экран. */
QPushButton[primary="true"] {
    background-color: ${ACCENT};
    border-color: ${ACCENT};
    color: #ffffff;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background-color: ${ACCENT_HOVER};
    border-color: ${ACCENT_HOVER};
}

QPushButton[primary="true"]:pressed {
    background-color: ${ACCENT_PRESSED};
    border-color: ${ACCENT_PRESSED};
}

QPushButton[primary="true"]:focus {
    border-color: ${ACCENT_PRESSED};
}

QPushButton[primary="true"]:disabled {
    background-color: #eef1f5;
    border-color: #d8dee7;
    color: #9aa5b1;
}

/* Перебор лучей стрелками — самый частый клик в программе, поэтому кнопка
   не мельче 28 px (было 26 при иконке 14). */
QToolButton[navButton="true"] {
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 6px;
}

QToolButton[plotTool="true"] {
    padding: 0;
    border-radius: 6px;
}

QTableView,
QTableWidget,
QListView,
QListWidget,
QTreeView {
    background-color: #ffffff;
    alternate-background-color: #fbfcfe;
    border: 1px solid #d8dee7;
    border-radius: 5px;
    gridline-color: #eef2f6;
}

QTableView::item,
QTableWidget::item,
QListView::item,
QListWidget::item,
QTreeView::item {
    padding: 4px;
}

QTableView::item:selected,
QTableWidget::item:selected,
QListView::item:selected,
QListWidget::item:selected,
QTreeView::item:selected {
    background-color: ${ACCENT_SELECTION};
    color: #0f172a;
}

QHeaderView::section {
    background-color: #f6f8fb;
    border: 0;
    border-right: 1px solid #edf1f5;
    border-bottom: 1px solid #d8dee7;
    padding: 3px 5px;
    color: #475467;
    font-weight: 500;
}

QScrollArea,
QAbstractScrollArea {
    background-color: transparent;
}

QScrollBar:vertical {
    background: #edf1f6;
    width: 16px;
    margin: 16px 0 16px 0;
}

QScrollBar::handle:vertical {
    background: #b8c3d2;
    border-radius: 6px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #9aa8ba;
}

QScrollBar:horizontal {
    background: #edf1f6;
    height: 16px;
    margin: 0 16px 0 16px;
}

QScrollBar::handle:horizontal {
    background: #b8c3d2;
    border-radius: 6px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #9aa8ba;
}

QScrollBar::sub-line:vertical,
QScrollBar::add-line:vertical {
    background: #f8fafc;
    border: 1px solid #c9d2df;
    width: 16px;
    height: 16px;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    subcontrol-position: top;
}

QScrollBar::add-line:vertical {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom;
}

QScrollBar::sub-line:horizontal,
QScrollBar::add-line:horizontal {
    background: #f8fafc;
    border: 1px solid #c9d2df;
    width: 16px;
    height: 16px;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
}

QScrollBar::add-line:horizontal {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: right;
}

QScrollBar::sub-line:hover,
QScrollBar::add-line:hover {
    background: ${ACCENT_SOFT};
    border-color: ${ACCENT_SOFT_BORDER};
}

QScrollBar::up-arrow:vertical {
    image: url("${STYLE_DIR}/icons/chevron-up.svg");
    width: 8px;
    height: 8px;
}

QScrollBar::down-arrow:vertical {
    image: url("${STYLE_DIR}/icons/chevron-down.svg");
    width: 8px;
    height: 8px;
}

QScrollBar::left-arrow:horizontal {
    image: url("${STYLE_DIR}/icons/chevron-left.svg");
    width: 8px;
    height: 8px;
}

QScrollBar::right-arrow:horizontal {
    image: url("${STYLE_DIR}/icons/chevron-right.svg");
    width: 8px;
    height: 8px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

QSplitter::handle {
    background-color: #d8dee7;
}

QSplitter::handle:hover {
    background-color: #b8c3d2;
}

QCheckBox,
QRadioButton {
    background: transparent;
    spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator {
    border: 1px solid #b8c3d2;
    border-radius: 4px;
    background-color: #ffffff;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: ${ACCENT_SOFT_BORDER};
    background-color: ${ACCENT_SOFT};
}

QCheckBox::indicator:checked {
    background-color: ${ACCENT};
    border-color: ${ACCENT};
    image: url("${STYLE_DIR}/icons/check.svg");
}

QCheckBox::indicator:checked:hover {
    background-color: ${ACCENT_PRESSED};
    border-color: ${ACCENT_PRESSED};
}

QCheckBox::indicator:disabled {
    background-color: #eef1f5;
    border-color: #d8dee7;
    image: none;
}

QCheckBox::indicator:checked:disabled {
    background-color: #b8c3d2;
    border-color: #b8c3d2;
    image: url("${STYLE_DIR}/icons/check.svg");
}

QRadioButton::indicator {
    border: 1px solid #b8c3d2;
    border-radius: 8px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: ${ACCENT_SOFT_BORDER};
    background-color: ${ACCENT_SOFT};
}

QRadioButton::indicator:checked {
    background-color: ${ACCENT};
    border: 4px solid #ffffff;
}

QRadioButton::indicator:checked:hover {
    background-color: ${ACCENT_PRESSED};
    border-color: #ffffff;
}

QRadioButton::indicator:disabled {
    background-color: #edf0f4;
    border-color: #d8dde5;
}

QRadioButton::indicator:checked:disabled {
    background-color: #c7cdd6;
    border-color: #edf0f4;
}

/* --- Общая полировка ---------------------------------------------------- */
QPushButton:checked,
QToolButton:checked {
    background-color: ${ACCENT_SOFT};
    border-color: ${ACCENT_SOFT_BORDER};
    color: ${ACCENT_TEXT};
    font-weight: 600;
}

QProgressBar {
    border: 1px solid #d8dee7;
    border-radius: 5px;
    background-color: #ffffff;
    text-align: center;
    min-height: 18px;
    color: #344054;
}

QProgressBar::chunk {
    background-color: ${ACCENT};
    border-radius: 4px;
    margin: 1px;
}

QToolTip {
    background-color: #1f2937;
    color: #ffffff;
    border: 0;
    padding: 4px 7px;
    border-radius: 4px;
}

/* Утилита «Дальняя зона» — подписи (стили вынесены из Python в общий QSS) */
QLabel#ffReadout {
    color: #475467;
    font-size: 8pt;
}

QLabel#ffFolderLabel {
    color: #667085;
}

QLabel[metricValue="true"] {
    font-weight: 600;
}

/* Таблица маркеров под графиком ДН: компактная, чтобы не отъедать высоту у
   самого графика. Значения набраны моноширинным — так цифры не «пляшут»
   при перетаскивании маркера. */
QTableWidget#ffMarkerTable {
    font-family: Consolas, "Courier New", monospace;
    font-size: 9pt;
    gridline-color: #eef2f6;
}

QTableWidget#ffMarkerTable::item {
    padding: 1px 6px;
}

QTableWidget#ffMarkerTable QHeaderView::section {
    font-family: "Segoe UI", sans-serif;
    font-size: 8pt;
    padding: 2px 6px;
}

/* Верхняя панель и статусная строка (окно переехало на QMainWindow) */
QToolBar {
    background-color: #ffffff;
    border: 0;
    border-bottom: 1px solid #d8dee7;
    padding: 6px 8px;
    spacing: 6px;
}

QToolBar::separator {
    background-color: #e2e8f0;
    width: 1px;
    margin: 3px 7px;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d8dee7;
}

QStatusBar::item {
    border: 0;
}

QSplitter::handle:horizontal {
    background-color: transparent;
    margin: 0 3px;
    border-left: 1px solid #e2e8f0;
}

QSplitter::handle:horizontal:hover {
    border-left: 1px solid ${ACCENT_SOFT_BORDER};
}
